generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String?
  email     String?  @unique
  bio       String?  @db.Text
  location  String?
  avatarUrl String?
  coverUrl  String?
  role      String   @default("user")
  status    String   @default("active") // active, suspended, banned
  banReason String?  @db.Text
  banExpiresAt DateTime?
  lastLoginIp  String?
  lastLoginAt  DateTime?
  bkashNumber  String?
  nagadNumber  String?
  bankDetails  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns        Campaign[]
  messages         Message[]
  notifications    Notification[]
  withdrawals      Withdrawal[]
  verificationDocs VerificationDocument[]
}

model Campaign {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  subtitle       String
  category       String
  location       String
  description    String
  coverImageUrl  String?
  goalAmount     Float?
  raisedAmount   Float    @default(0)
  targetParticipants Int?
  
  campaignType   String   @default("flexible")
  fixedAmount    Float?

  isFeatured     Boolean  @default(false)
  isPinned       Boolean  @default(false)
  status         String   @default("active")
  deletedAt      DateTime?
  pausedAt       DateTime?

  bkashNumber    String?
  nagadNumber    String?
  bankDetails    String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creatorId      String
  creator        User     @relation(fields: [creatorId], references: [id])
  
  milestones       Milestone[]
  transactions     Transaction[]
  updates          Update[]
  withdrawals      Withdrawal[]
  reports          Report[]
  verificationDocs VerificationDocument[]

  @@index([status])
  @@index([category])
  @@index([isFeatured])
  @@index([creatorId])
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  completed   Boolean  @default(false)
  
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  donorName   String
  phone       String
  amount      Float
  method      String
  referenceId String?
  message     String?  // Optional support message from the donor
  status      String   @default("pending")
  
  date        DateTime @default(now())

  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@index([campaignId, status])
}

model Update {
  id          String   @id @default(cuid())
  title       String
  content     String
  date        DateTime @default(now())

  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(cuid())
  senderName  String
  email       String?
  content     String   @db.Text
  isRead      Boolean  @default(false)
  date        DateTime @default(now())

  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  message     String
  isRead      Boolean  @default(false)
  date        DateTime @default(now())
  actionUrl   String?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminNote {
  id          String   @id @default(cuid())
  targetType  String   // "Campaign", "User", "Transaction", "Withdrawal"
  targetId    String
  content     String   @db.Text
  authorId    String
  authorName  String
  authorRole  String
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorName     String
  actorRole     String
  action        String   // APPROVE_CAMPAIGN, REJECT_CAMPAIGN, VERIFY_TRANSACTION, etc.
  resourceType  String   // Campaign, Transaction, User, Withdrawal
  resourceId    String
  oldValue      String?
  newValue      String?
  reason        String?  @db.Text
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId])
}

model Withdrawal {
  id              String   @id @default(cuid())
  amount          Float
  method          String   // bKash, Nagad, Bank Transfer
  accountDetails  String
  status          String   @default("requested") // requested, approved, rejected, transferred, completed
  assignedTo      String?
  priority        String   @default("NORMAL") // NORMAL, HIGH, URGENT
  reason          String?  @db.Text

  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([creatorId])
}

model VerificationSettings {
  id                              String   @id @default("default")
  requireNid                      Boolean  @default(true)
  requireSelfie                   Boolean  @default(true)
  requireMedicalCert              Boolean  @default(true)
  requireHospitalQuotation        Boolean  @default(true)
  requireIncomeProof              Boolean  @default(false)
  requireGuardianDoc              Boolean  @default(false)
  requireSupportingImages        Boolean  @default(true)
  requireAdditionalAttachments   Boolean  @default(false)
  updatedAt                       DateTime @updatedAt
}

model FeatureFlag {
  id          String   @id
  key         String   @unique
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
}

model EmailLog {
  id             String   @id @default(cuid())
  recipientEmail String
  recipientName  String?
  subject        String
  body           String   @db.Text
  templateName   String?
  status         String   @default("sent") // sent, failed
  senderId       String?
  createdAt      DateTime @default(now())
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id              String   @id @default(cuid())
  targetType      String   // Campaign, User
  targetId        String
  reporterName    String   @default("Anonymous User")
  reason          String   @db.Text
  status          String   @default("under_review") // under_review, resolved, dismissed
  priority        String   @default("NORMAL") // NORMAL, HIGH, URGENT
  assignedTo      String?
  resolutionNotes String?  @db.Text

  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([status])
}

model VerificationDocument {
  id            String    @id @default(cuid())
  documentType  String    // "National ID (Front)", "National ID (Back)", "Biometric Selfie with NID", "Medical Certificate", "Hospital Cost Estimate"
  storageUrl    String    // Local asset path or Cloud Storage URL
  mimeType      String    @default("image/png")
  size          Int       @default(245000) // bytes
  status        String    @default("verified") // "pending", "verified", "flagged", "rejected"
  remarks       String?   @db.Text
  uploadedAt    DateTime  @default(now())
  verifiedAt    DateTime?
  verifiedBy    String?

  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creatorId     String?
  creator       User?     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([creatorId])
  @@index([status])
}

